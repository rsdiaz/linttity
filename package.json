{
  "name": "linttity",
  "version": "1.1.2",
  "description": "Automate ESlint and Prettier configuration and install the necessary packages for Nodejs projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "linttity": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepare": "npm run build",
    "release:patch": "node scripts/release-patch.mjs",
    "release:checklist": "node scripts/create-release-checklist.mjs",
    "release:preflight": "npm run format:check && npm run build && npm run lint && npm test",
    "release:check": "npm run release:preflight && npm pack --dry-run && npm publish --dry-run",
    "test": "node --test tests/**/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
